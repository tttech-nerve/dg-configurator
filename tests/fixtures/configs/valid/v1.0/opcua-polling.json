{
  "version": "1.0",
  "endpoints": [
    {
      "id": 1,
      "name": "plc",
      "endpointType": "opcua-client",
      "url": "opc.tcp://plc.local:4840",
      "inputs": [
        {
          "id": 1,
          "name": "process-values",
          "inputType": "opcua-polling",
          "pollingIntervalMS": 1000,
          "nodes": [{"node": "ns=2;s=Temperature"}]
        }
      ]
    },
    {
      "id": 2,
      "name": "broker",
      "endpointType": "mqtt-client",
      "url": "mqtt://broker.local:1883",
      "outputs": [
        {"id": 1, "name": "values-out", "outputType": "mqtt-publisher", "messageFormat": "protobuf", "topic": "out/plc"}
      ]
    }
  ],
  "connections": [
    {"id": 1, "name": "plc-to-broker", "source": {"endpoint": 1, "input": 1}, "destination": {"endpoint": 2, "output": 1}}
  ]
}
