{
  "version": "1.1",
  "passwordPolicy": {"minLength": 20, "maxLength": 32, "useSymbols": false},
  "endpoints": [
    {
      "id": 1,
      "name": "mqtt-in",
      "endpointType": "mqtt-client",
      "url": "mqtt://broker.local:1883",
      "inputs": [
        {
          "id": 1,
          "name": "temp",
          "inputType": "mqtt-subscriber",
          "messageFormat": "json",
          "variableSchema": {"temperature": "double", "tags": {"line": "string", "samples": "int32[]"}},
          "topics": [{"topic": "sensors/temp"}]
        }
      ]
    },
    {
      "id": 2,
      "name": "history",
      "endpointType": "sql-client",
      "dbType": "questdb",
      "host": "db.local",
      "outputs": [
        {"id": 1, "name": "readings", "outputType": "sql-columnar-writer", "table": "readings"}
      ]
    }
  ],
  "connections": [
    {"id": 1, "name": "to-db", "source": {"endpoint": 1, "input": 1}, "destination": {"endpoint": 2, "output": 1}}
  ]
}
