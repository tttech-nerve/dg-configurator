{
  "version": "1.1",
  "endpoints": [
    {
      "id": 1,
      "name": "raw-in",
      "endpointType": "mqtt-client",
      "url": "mqtt://broker.local:1883",
      "inputs": [
        {
          "id": 1,
          "name": "frames",
          "inputType": "mqtt-subscriber",
          "messageFormat": "binary",
          "topics": [{"topic": "raw/#", "qos": 1, "rateLimit": 10}]
        }
      ]
    },
    {
      "id": 2,
      "name": "history",
      "endpointType": "sql-client",
      "dbType": "postgresql",
      "host": "db.local",
      "outputs": [
        {
          "id": 1,
          "name": "raw-frames",
          "outputType": "sql-binary-writer",
          "table": "frames",
          "dataColumn": "payload",
          "retentionPeriod": 1440
        }
      ]
    }
  ],
  "connections": [
    {"id": 1, "name": "frames-to-db", "source": {"endpoint": 1, "input": 1}, "destination": {"endpoint": 2, "output": 1}}
  ]
}
