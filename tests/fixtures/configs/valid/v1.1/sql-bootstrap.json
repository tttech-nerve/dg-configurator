{
  "$schema": "https://docs.nerve.cloud/datagate/v110/configuration/static/config-schema-v1.1.json",
  "version": "1.1",
  "endpoints": [
    {
      "id": 1,
      "name": "plc",
      "endpointType": "opcua-client",
      "url": "opc.tcp://plc.local:4840",
      "inputs": [
        {
          "id": 1,
          "name": "process-values",
          "inputType": "opcua-subscriber",
          "samplingIntervalMS": 500,
          "publishingIntervalMS": 1000,
          "nodes": [{"node": "ns=2;s=Temperature", "nameFromNodeID": true, "register": true}]
        }
      ]
    },
    {
      "id": 2,
      "name": "history",
      "endpointType": "sql-client",
      "dbType": "timescaledb",
      "host": "db.local",
      "port": 5432,
      "database": "gateway",
      "login": {"username": "gateway", "password": "secret"},
      "bootstrap": {
        "enabled": true,
        "admin": {"username": "postgres", "password": "admin-secret"},
        "allowPlaintextExport": true,
        "exportUser": {"username": "reader", "privilege": "read-only"}
      },
      "outputs": [
        {
          "id": 1,
          "name": "readings",
          "outputType": "sql-columnar-writer",
          "table": "readings",
          "autoCreateTable": true,
          "nestedVariableDelimiter": "."
        }
      ]
    }
  ],
  "connections": [
    {"id": 1, "name": "plc-to-db", "source": {"endpoint": 1, "input": 1}, "destination": {"endpoint": 2, "output": 1}}
  ]
}
