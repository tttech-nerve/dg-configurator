{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.nerve.cloud/datagate/v100/configuration/static/config-schema-v1.0.json",
  "title": "Nerve Data Gateway User Configuration (v1.0)",
  "description": "Schema for the Data Gateway `config.json` file with `version` = \"1.0\". Introduced in Data Gateway 1.0.0, still accepted by 1.1.0 for backwards compatibility. Supports only the `mqtt-client` and `opcua-client` endpoint types. Authoritative source: data-gateway-documentation/configuration/config-schema-v1.0.json.",
  "type": "object",
  "required": ["version", "endpoints", "connections"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional URL of this schema — allows editors to provide autocompletion and validation."
    },
    "version": {
      "const": "1.0",
      "description": "Configuration file schema version. Must be the literal string \"1.0\" for this schema."
    },
    "endpoints": {
      "type": "array",
      "description": "Every external system the Data Gateway connects to (data sources and sinks).",
      "items": { "$ref": "#/$defs/Endpoint" }
    },
    "connections": {
      "type": "array",
      "description": "Wires exactly one input on one endpoint to exactly one output on another endpoint.",
      "items": { "$ref": "#/$defs/Connection" }
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Uint32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "Endpoint": {
      "type": "object",
      "required": ["id", "name", "endpointType"],
      "properties": {
        "id": {
          "$ref": "#/$defs/Uint32",
          "description": "Identifier — must be unique among all endpoints."
        },
        "name": {
          "type": "string",
          "description": "Human-readable name of the endpoint."
        },
        "description": {
          "type": "string",
          "default": "",
          "description": "Human-readable description of the endpoint."
        },
        "endpointType": {
          "enum": ["opcua-client", "mqtt-client"],
          "description": "Type of the endpoint. Determines which additional parameters are valid."
        }
      },
      "oneOf": [
        { "$ref": "#/$defs/MqttEndpoint" },
        { "$ref": "#/$defs/OpcuaEndpoint" }
      ]
    },
    "MqttEndpoint": {
      "type": "object",
      "required": ["endpointType", "url"],
      "properties": {
        "endpointType": { "const": "mqtt-client" },
        "url": {
          "type": "string",
          "pattern": "^mqtts?://",
          "description": "MQTT broker URL. `mqtt://` requires `security.tlsEnabled = false`; `mqtts://` requires `security.tlsEnabled = true`."
        },
        "reconnectInterval": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400,
          "default": 5,
          "description": "Seconds to wait before each reconnection attempt after unexpected connection loss."
        },
        "version": {
          "enum": ["5.0"],
          "default": "5.0",
          "description": "MQTT protocol version to use for the connection."
        },
        "clientID": {
          "type": "string",
          "default": "data-gateway-client",
          "description": "MQTT client identifier used when connecting to the broker."
        },
        "websockets": {
          "type": "boolean",
          "default": false,
          "description": "If true, use MQTT over WebSockets."
        },
        "login": { "$ref": "#/$defs/UserPasswordLogin" },
        "security": { "$ref": "#/$defs/MqttSecurity" },
        "advanced": { "$ref": "#/$defs/MqttAdvanced" },
        "inputs": {
          "type": "array",
          "default": [],
          "items": { "$ref": "#/$defs/MqttSubscriberInput" }
        },
        "outputs": {
          "type": "array",
          "default": [],
          "items": { "$ref": "#/$defs/MqttPublisherOutput" }
        }
      }
    },
    "OpcuaEndpoint": {
      "type": "object",
      "required": ["endpointType", "url"],
      "properties": {
        "endpointType": { "const": "opcua-client" },
        "url": {
          "type": "string",
          "pattern": "^opc\\.tcp://",
          "description": "OPC UA server URL (opc.tcp://host:port/path)."
        },
        "reconnectInterval": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400,
          "default": 5,
          "description": "Seconds to wait before each reconnection attempt after unexpected connection loss."
        },
        "login": { "$ref": "#/$defs/UserPasswordLogin" },
        "security": { "$ref": "#/$defs/OpcuaSecurity" },
        "inputs": {
          "type": "array",
          "default": [],
          "items": { "$ref": "#/$defs/OpcuaInput" }
        },
        "outputs": {
          "type": "array",
          "default": [],
          "maxItems": 0,
          "description": "The opcua-client endpoint currently does not support outputs — must be an empty array."
        }
      }
    },
    "UserPasswordLogin": {
      "type": "object",
      "description": "Credentials for username / password authentication. Omit the whole object for anonymous.",
      "properties": {
        "username": { "type": "string" },
        "password": { "type": "string" }
      },
      "additionalProperties": false
    },
    "MqttSecurity": {
      "type": "object",
      "description": "TLS / SSL settings for the MQTT endpoint.",
      "properties": {
        "tlsEnabled": { "type": "boolean", "default": false },
        "ca": { "type": "string", "description": "Filename of the CA certificate (PEM) used to verify the broker certificate." },
        "certificate": { "type": "string", "description": "Filename of the client certificate (PEM)." },
        "key": { "type": "string", "description": "Filename of the client key (PEM)." },
        "keyPassword": { "type": "string", "description": "Password for the client key file." },
        "tlsVersion": { "enum": ["1.2", "1.3"], "default": "1.3" },
        "tlsInsecure": { "type": "boolean", "default": false, "description": "If true, the broker certificate is not verified." }
      },
      "additionalProperties": false
    },
    "OpcuaSecurity": {
      "type": "object",
      "description": "OPC UA security settings.",
      "properties": {
        "mode": {
          "enum": ["None", "Sign", "SignAndEncrypt"],
          "default": "None",
          "description": "OPC UA MessageSecurityMode. See https://reference.opcfoundation.org/Core/Part2/v104/docs/4.8"
        },
        "policy": {
          "enum": ["None", "Basic128Rsa15", "Basic256", "Basic256Sha256", "Aes128Sha256RsaOaep", "Aes256Sha256RsaPss"],
          "default": "None",
          "description": "OPC UA SecurityPolicy. See https://reference.opcfoundation.org/Core/Part2/v104/docs/4.6"
        },
        "ca": { "type": "string", "description": "Filename of the CA certificate (PEM) used to verify the server certificate." },
        "certificate": { "type": "string", "description": "Filename of the client certificate (PEM)." },
        "key": { "type": "string", "description": "Filename of the client key (PEM)." },
        "keyPassword": { "type": "string", "description": "Password for the client key file." }
      },
      "additionalProperties": false
    },
    "MqttAdvanced": {
      "type": "object",
      "description": "Advanced MQTT connection settings.",
      "properties": {
        "keepAlive": { "type": "integer", "minimum": 0, "maximum": 65535, "default": 60, "description": "Seconds between keep-alive messages." },
        "cleanSession": { "type": "boolean", "default": false },
        "willTopic": { "type": "string", "description": "Topic for the last will testament (LWT) message." },
        "willMessage": { "type": "string", "description": "Content of the LWT message." },
        "willQoS": { "type": "integer", "minimum": 0, "maximum": 2, "default": 1 },
        "willRetain": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "MqttSubscriberInput": {
      "type": "object",
      "required": ["id", "name", "inputType", "messageFormat", "topics"],
      "properties": {
        "id": { "$ref": "#/$defs/Uint32", "description": "Identifier — must be unique among all inputs of the endpoint." },
        "name": { "type": "string" },
        "description": { "type": "string", "default": "" },
        "inputType": { "const": "mqtt-subscriber" },
        "messageFormat": {
          "enum": ["json", "protobuf"],
          "description": "Format of the incoming MQTT message payload."
        },
        "topics": {
          "type": "array",
          "items": { "$ref": "#/$defs/MqttTopicSubscription" },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "MqttTopicSubscription": {
      "type": "object",
      "required": ["topic"],
      "properties": {
        "topic": {
          "type": "string",
          "description": "Topic to subscribe to. Supports MQTT wildcards `+` and `#`."
        },
        "qos": { "type": "integer", "minimum": 0, "maximum": 2, "default": 0 },
        "rateLimit": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "0 = no rate limit. >0 = maximum number of messages received per second (sliding window); additional messages are dropped."
        }
      },
      "additionalProperties": false
    },
    "MqttPublisherOutput": {
      "type": "object",
      "required": ["id", "name", "outputType", "messageFormat", "topic"],
      "properties": {
        "id": { "$ref": "#/$defs/Uint32", "description": "Identifier — must be unique among all outputs of the endpoint." },
        "name": { "type": "string" },
        "description": { "type": "string", "default": "" },
        "outputType": { "const": "mqtt-publisher" },
        "messageFormat": {
          "enum": ["json", "protobuf"],
          "description": "Format of the outgoing MQTT message payload."
        },
        "topic": {
          "type": "string",
          "description": "Topic to publish to."
        },
        "qos": { "type": "integer", "minimum": 0, "maximum": 2, "default": 0 }
      },
      "additionalProperties": false
    },
    "OpcuaInput": {
      "type": "object",
      "required": ["id", "name", "inputType", "nodes"],
      "properties": {
        "id": { "$ref": "#/$defs/Uint32", "description": "Identifier — must be unique among all inputs of the endpoint." },
        "name": { "type": "string" },
        "description": { "type": "string", "default": "" },
        "inputType": { "enum": ["opcua-polling", "opcua-subscriber"] },
        "pollingIntervalMS": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000,
          "description": "Polling interval in milliseconds. Only for inputType = opcua-polling."
        },
        "samplingIntervalMS": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000,
          "description": "Interval at which the server should sample the object (ms). Only for inputType = opcua-subscriber."
        },
        "publishingIntervalMS": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000,
          "description": "Interval at which the server should publish the object (ms). Only for inputType = opcua-subscriber."
        },
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/OpcuaNode" },
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "inputType": { "const": "opcua-polling" } }, "required": ["inputType"] },
          "then": { "required": ["pollingIntervalMS"] }
        },
        {
          "if": { "properties": { "inputType": { "const": "opcua-subscriber" } }, "required": ["inputType"] },
          "then": { "required": ["samplingIntervalMS", "publishingIntervalMS"] }
        }
      ]
    },
    "OpcuaNode": {
      "type": "object",
      "required": ["node"],
      "properties": {
        "node": {
          "type": "string",
          "description": "OPC UA node id of the object to be polled / subscribed."
        },
        "nameFromNodeID": {
          "type": "boolean",
          "default": false,
          "description": "If true, the resulting variable name is the full OPC UA node id; otherwise the display name of the OPC UA object is used."
        },
        "register": {
          "type": "boolean",
          "default": false,
          "description": "If true, register the node (or all sub-nodes for a folder) at the OPC UA server. See https://reference.opcfoundation.org/Core/Part4/v104/docs/5.8.5"
        }
      },
      "additionalProperties": false
    },
    "Connection": {
      "type": "object",
      "required": ["id", "name", "source", "destination"],
      "properties": {
        "id": { "$ref": "#/$defs/Uint32", "description": "Identifier — must be unique among connections." },
        "name": { "type": "string" },
        "description": { "type": "string", "default": "" },
        "source": { "$ref": "#/$defs/ConnectionSource" },
        "destination": { "$ref": "#/$defs/ConnectionDestination" }
      },
      "additionalProperties": false
    },
    "ConnectionSource": {
      "type": "object",
      "required": ["endpoint", "input"],
      "properties": {
        "endpoint": { "$ref": "#/$defs/Uint32", "description": "Id of the endpoint that holds the input to connect." },
        "input": { "$ref": "#/$defs/Uint32", "description": "Id of the input to connect." }
      },
      "additionalProperties": false
    },
    "ConnectionDestination": {
      "type": "object",
      "required": ["endpoint", "output"],
      "properties": {
        "endpoint": { "$ref": "#/$defs/Uint32", "description": "Id of the endpoint that holds the output to connect." },
        "output": { "$ref": "#/$defs/Uint32", "description": "Id of the output to connect." }
      },
      "additionalProperties": false
    }
  }
}
